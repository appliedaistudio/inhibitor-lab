# =========================================================
# NotSoFast Landlord — environment variables
# Copy this file to .env and fill in the blanks.
# Event staff will provide the Inhibitor and OpenAI keys.
# =========================================================

# --- LLM ---
LLM_PROVIDER=openai                    # "openai" or "claude_cli"
OPENAI_API_KEY=sk-...                  # provided by event staff if needed
OPENAI_MODEL=gpt-4o                    # or gpt-4o-mini for cheaper dev
FAST_MODEL=gpt-4o-mini                 # used for intake + critic (fast path)
# Claude CLI provider (fallback — uses Claude Code OAuth, no API key)
CLAUDE_MAIN_MODEL=sonnet
CLAUDE_FAST_MODEL=haiku
CLAUDE_BINARY=claude

# --- Inhibitor (Applied AI Studio) ---
# Docs:   https://github.com/appliedaistudio/inhibitor-lab/blob/main/docs/inhibitor-api.md
# OpenAPI: https://iaas.appliedai.studio/openapi.json
INHIBITOR_API_KEY=                     # provided by Applied AI booth
INHIBITOR_API_URL=https://iaas.appliedai.studio/check
INHIBITOR_TIMEOUT_SECONDS=30
INHIBITOR_MODE=insight                 # "insight" (rich) or "performance" (fast)

# --- Twilio (SMS surface) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=                   # the Philly number judges will text

# --- Drone (DJI Tello) ---
# Regular Tello: laptop must connect to Tello's Wi-Fi AP directly.
# Tello EDU: set station-mode credentials so drone joins YOUR wifi.
TELLO_MODE=regular                     # "regular" or "edu"
TELLO_STATION_SSID=                    # only for EDU mode
TELLO_STATION_PASSWORD=                # only for EDU mode

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8765
LOG_DIR=backend/logs

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8765
