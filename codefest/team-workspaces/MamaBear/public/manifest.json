{
  "manifest_version": 3,
  "name": "MamaBear Web Shield",
  "version": "0.1.0",
  "description": "Auto-checks search queries and warns or blocks potentially harmful content.",
  "permissions": ["storage", "activeTab", "tabs", "scripting", "webNavigation"],
  "host_permissions": [
    "<all_urls>",
    "https://iaas.appliedai.studio/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  }
}
